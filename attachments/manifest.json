{
  "manifest_version": 3,
  "name": "Répète-Actions",
  "version": "1.0.0",
  "description": "Enregistre tes clics, défilements et frappes clavier, puis rejoue-les à la vitesse voulue.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Répète-Actions"
  }
}
